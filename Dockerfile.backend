FROM node:20-alpine

WORKDIR /app

# Install dependencies first (layer caching)
COPY package*.json tsconfig.json server.ts prisma.config.ts ./
RUN npm install

# Copy server code (app, routes, services, middleware, db)
COPY server/ ./server/
COPY prisma/ ./prisma/

# Generate Prisma Client
RUN npx prisma generate --schema=./prisma/schema.prisma

# Ensure uploads directories exist and are writable by the node runtime user.
# Multer writes incoming multipart files to uploads/temp before handler runs;
# without write permission the POST /:id/files endpoint returns EACCES (500).
RUN mkdir -p uploads/temp uploads/pending uploads/approved \
    && chown -R node:node uploads

# Expose API port
EXPOSE 8001

# Start server with tsx watch (auto-reload on changes)
CMD ["npx", "tsx", "watch", "server.ts"]