# ============================================================
# BVĐK Website — Environment variables
# ============================================================

# --- Database ---
DATABASE_URL=postgresql://postgres:devpass@localhost:5432/bvdh_db?schema=public
SHADOW_DATABASE_URL=postgresql://postgres:devpass@localhost:5432/bvdh_shadow?schema=public

# --- App ---
NODE_ENV=development
PORT=8001
CORS_ORIGIN=http://localhost:3000

# --- Secrets (BẮT BUỘC đổi trong production — fail-fast nếu thiếu) ---
JWT_SECRET=dev-secret-change-in-production-min-32-chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
CONSENT_SECRET=dev-consent-secret-change-in-production
CCCD_SECRET=dev-cccd-secret-change-in-production

# --- Admin seed (dùng cho `prisma db seed`; nên bỏ sau khi deploy) ---
ADMIN_DEFAULT_PASSWORD=Admin@123

# --- AI Studio / Gemini API Key ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Frontend build (Vite) ---
VITE_APP_NAME="BVĐK KV Miền Núi Phía Bắc Quảng Nam"
VITE_HOSPITAL_ADDRESS="107 Quang Trung, Xã Đại Lộc, TP. Đà Nẵng"
VITE_HOTLINE="02353.747.433"
VITE_API_URL=/api
